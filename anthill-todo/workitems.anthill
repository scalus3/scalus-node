fact WorkItem(
  id: "WI-014",
  description: "HOAS macro frontend for stream queries: lower a Scala lambda (e.g. utxo => utxo.address == addr && utxo.value.coin > Coin(X)) to the existing UtxoQuery ADT at compile time. Lives in scalus-node (this repo) alongside the streaming provider — macro reads the Tasty tree, recognises supported predicate shapes (Addr / Asset / TxOuts / Inputs equalities, AND/OR), emits a structured UtxoQuery plus a residual lambda for post-filter. Engine, ChainStore, persistence, LSQ, N2C are all unaffected: the runtime sees the same UtxoQuery values it sees today. Unsupported lambda shapes fail at compile time with a clear message. No deps on any other WI.",
  acceptance: [ToolPasses("cargo-test")],
  depends_on: [],
  status: Verified(at: "2026-05-06T17:11:56Z"))

